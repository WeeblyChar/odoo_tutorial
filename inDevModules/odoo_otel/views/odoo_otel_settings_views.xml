<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_odoo_otel_settings_form" model="ir.ui.view">
        <field name="name">odoo.otel.settings.form</field>
        <field name="model">odoo.otel.settings</field>
        <field name="arch" type="xml">
            <form string="Odoo OpenTelemetry Settings">
                <group>
                    <field name="otlp_endpoint"/>
                    <button name="send_custom_trace"
                            type="object"
                            string="Send Trace"
                            class="btn-primary"/>
                </group>
                <footer>

                </footer>
            </form>
        </field>
    </record>

    <record id="action_odoo_otel_settings" model="ir.actions.act_window">
        <field name="name">OpenTelemetry Settings</field>
        <field name="res_model">odoo.otel.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odoo_otel_settings_form"/>
        <field name="target">current</field>
    </record>
</odoo>
